# rules_tectonic bazelrc
# Bound the client server: it exits after 120 s idle (TIN-5770, R470).
startup --max_idle_secs=120
common --enable_bzlmod
build --incompatible_strict_action_env
test --test_output=errors
# No remote lane is enrolled. A remote failure must not fall back to local (R471).
build --remote_local_fallback=false
