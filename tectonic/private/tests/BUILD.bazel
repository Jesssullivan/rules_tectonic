load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:private"])

# GraphQL-authored source files are intentionally 0644. Generate the executable
# test carrier inside Bazel rather than weakening repository signing provenance.
genrule(
    name = "stage_cleanup_test_runner",
    srcs = ["stage_cleanup_test.sh"],
    outs = ["stage_cleanup_test_runner.sh"],
    cmd = "cp $(location stage_cleanup_test.sh) $@ && chmod 0755 $@",
    executable = True,
)

sh_test(
    name = "stage_cleanup_test",
    srcs = [":stage_cleanup_test_runner"],
    data = ["//tectonic/private:stage_cleanup_lib"],
)
