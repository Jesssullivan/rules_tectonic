load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "platforms.bzl",
    "tectonic_pdf.bzl",
    "tectonic_repository.bzl",
    "tectonic_toolchain.bzl",
])

bzl_library(
    name = "platforms_bzl",
    srcs = ["platforms.bzl"],
)

bzl_library(
    name = "tectonic_pdf_bzl",
    srcs = ["tectonic_pdf.bzl"],
)

bzl_library(
    name = "tectonic_repository_bzl",
    srcs = ["tectonic_repository.bzl"],
    deps = [":platforms_bzl"],
)

bzl_library(
    name = "tectonic_toolchain_bzl",
    srcs = ["tectonic_toolchain.bzl"],
)

filegroup(
    name = "stage_cleanup_lib",
    srcs = ["stage_cleanup.sh"],
    visibility = [
        "//tectonic/private:__pkg__",
        "//tectonic/private/tests:__pkg__",
    ],
)
